# Copy this file to backend/.env and fill in real values.
# See README.md section IV for the full explanation of each variable.

# ---------------------------------------------------------------------------
# Required — the app will not start without these.
# ---------------------------------------------------------------------------

# Full MongoDB connection string.
MONGO_URL=mongodb://localhost:27017

# Name of the MongoDB database to use.
DB_NAME=khova_ai

# Key passed to emergentintegrations for all AI calls. Required for any
# AI-powered feature (research, opportunities, writing, images, etc).
EMERGENT_LLM_KEY=

# ---------------------------------------------------------------------------
# Required in practice — see the CORS_ORIGINS note below.
# ---------------------------------------------------------------------------

# Comma-separated list of allowed frontend origin(s), e.g.
#   CORS_ORIGINS=https://app.example.com
# The backend uses allow_credentials=True for cookie-based auth, and browsers
# refuse to honor a wildcard Access-Control-Allow-Origin together with
# credentialed requests — so leaving this unset breaks cross-origin login
# silently. The app fails to start if this is left at its "*" default unless
# KHOVA_ALLOW_WILDCARD_CORS=true is also set.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Optional — safe defaults shown; uncomment/change only if you need to.
# ---------------------------------------------------------------------------

# Comma-separated list of emails granted the `admin` role. The shipped
# default (admin@khova.ai) is a public, predictable value baked into the
# open-source code — set this explicitly before going live.
# KHOVA_ADMIN_EMAILS=admin@khova.ai

# Set to true ONLY for same-origin local development, to acknowledge that
# CORS_ORIGINS is intentionally left at its insecure "*" default. Never set
# this in a real deployment.
# KHOVA_ALLOW_WILDCARD_CORS=false

# Set to true ONLY if this app sits behind a reverse proxy that OVERWRITES
# (not appends to) X-Forwarded-For/X-Real-IP before requests reach it.
# Otherwise any caller can spoof a fresh IP per request and bypass the
# anonymous-tier AI rate limiter entirely. Defaults to false (uses the real
# socket peer address instead).
# KHOVA_TRUST_PROXY_HEADERS=false

# Enables the TEST-ONLY /api/auth/dev-login bypass. Must never be set in
# production — it lets anyone log in as any email with no verification.
# KHOVA_ENABLE_DEV_LOGIN=false

# Anonymous-funnel (pre-signup) AI rate limiter tuning. Defaults shown.
# KHOVA_ANON_MAX_AI=8
# KHOVA_ANON_WINDOW_SEC=3600
# KHOVA_ANON_MIN_INTERVAL_SEC=3
# KHOVA_ANON_COOLDOWN_SEC=600
# KHOVA_ANON_DEDUP_SEC=30
